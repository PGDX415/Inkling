/* Help */
"help.title" = "使用帮助";
"help.ai_title" = "AI 润色（核心功能）";
"help.ai_body" = "拾光内置 AI 润色，帮助你将随手写下的文字润色为更优美的表达。\n\n1. 在「设置 > AI 润色」中填入 API 密钥（推荐 DeepSeek，免费注册即可获得）。\n2. 写完日记后，在详情页右上角点击 ✨ 按钮，或进入编辑页点击键盘上方的「润色」按钮。\n3. AI 会自动优化语法、用词和逻辑流畅度，保持原意不变。\n4. 如不满意可继续点击润色，或手动修改。";
"help.write_title" = "写日记";
"help.write_body" = "点击首页右上角 ✏️ 按钮即可新建日记。支持键盘输入、语音录入或手写。日记会自动保存，无需手动操作。每篇日记可以添加最多 5 张照片。";
"help.calendar_title" = "时光之历";
"help.calendar_body" = "底部「时光之历」标签页可查看日历。有日记的日期会显示圆点标记，点击日期可浏览当天的所有日记。";
"help.photo_title" = "照片";
"help.photo_body" = "编辑日记时可插入照片（最多 5 张）。点击照片可全屏查看，支持双指缩放和拖动。";
"help.font_title" = "字体与外观";
"help.font_body" = "在「设置 > 字体」中可选：宋体（古典衬线）、楷体（手写风格）、苹方（现代无衬线）。字号可在 14-24pt 之间调节。「设置 > 显示 > 外观」支持深色/浅色模式切换。";
"help.lock_title" = "隐私锁定";
"help.lock_body" = "在「设置 > 隐私」中开启锁定后，应用每次打开或切回前台时，需要面容 ID / 触控 ID 验证。";
"help.sync_title" = "iCloud 同步";
"help.sync_body" = "日记数据通过 iCloud 自动在所有 Apple 设备间同步，无需手动操作。离线时正常使用，联网后自动同步。";
"help.export_title" = "导出与导入";
"help.export_body" = "在「设置 > 数据」中可导出全部日记为文本文件（含照片），方便备份。也可从之前导出的文件恢复日记。";

/* Privacy Policy */
"privacy.nav_title" = "隐私政策";
"privacy.title" = "拾光（Inkling）隐私政策";
"privacy.intro" = "拾光是一款极简日记应用。我们深知隐私对您的重要性，因此从设计之初便将隐私保护作为核心原则。本隐私政策将清晰说明我们如何处理您的数据。";
"privacy.s1_title" = "1. 数据存储与同步";
"privacy.s1_body" = "您的所有日记内容、照片和个人资料均存储在您的设备本地，并通过您个人的 iCloud 账户（CloudKit）在您的设备间同步。拾光不会将您的数据上传至任何第三方服务器，也不会在任何情况下访问您的日记内容。iCloud 同步完全由 Apple 提供，受 Apple 隐私政策保护。";
"privacy.s2_title" = "2. AI 润色功能";
"privacy.s2_body" = "拾光提供可选的 AI 润色功能，支持 DeepSeek、硅基流动和 Google Gemini 三种服务商。当您使用 AI 润色时，您选中的日记文本将被发送至对应服务商的 API 进行处理。此功能完全由您主动触发，拾光不会在后台自动发送任何内容。各 AI 服务商的数据处理政策请参阅其各自的隐私政策。";
"privacy.s3_title" = "3. 生物识别认证";
"privacy.s3_body" = "拾光支持使用面容 ID 或触控 ID 锁定应用。此功能完全在设备本地完成，您的生物识别数据由 Apple 操作系统管理，拾光无法访问您的面容或指纹数据。";
"privacy.s4_title" = "4. 数据导出与删除";
"privacy.s4_body" = "您可以随时导出所有日记为文本文件，也可以随时删除单篇日记或清空所有数据。删除操作不可撤销，数据将从您的设备和 iCloud 中永久移除。";
"privacy.s5_title" = "5. 第三方服务";
"privacy.s5_body" = "除您主动选择的 AI 润色服务外，拾光不使用任何第三方分析工具、广告 SDK 或数据追踪服务。我们不收集任何使用统计或崩溃报告。";
"privacy.s6_title" = "6. 儿童隐私";
"privacy.s6_body" = "拾光不面向 13 岁以下儿童，我们不会有意收集儿童的个人信息。";
"privacy.s7_title" = "7. 联系我们";
"privacy.s7_body" = "如果您对本隐私政策有任何疑问，请通过 GitHub Issues 与我们联系：\nhttps://github.com/PGDX415/Inkling/issues";
"privacy.last_updated" = "最后更新日期：";
